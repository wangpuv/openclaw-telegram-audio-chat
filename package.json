{
  "name": "openclaw-telegram-audio-chat",
  "version": "0.3.0",
  "description": "OpenClaw plugin that auto-sends Telegram voice bubble replies from assistant text using local TTS.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "telegram",
    "tts",
    "voice"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "openclaw": {
    "extensions": ["./index.ts"],
    "compat": {
      "pluginApi": "^1.2.0"
    },
    "build": {
      "openclawVersion": "2026.4.2",
      "pluginSdkVersion": "2026.4.2"
    }
  },
  "files": [
    "index.ts",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ]
}
